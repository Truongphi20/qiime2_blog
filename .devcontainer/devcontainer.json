{
  "name": "qiime2-dev-myst",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "yzhang.markdown-all-in-one",
        "mystmd.mystmd",
        "REditorSupport.r"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "forwardPorts": [3000, 3100]
}